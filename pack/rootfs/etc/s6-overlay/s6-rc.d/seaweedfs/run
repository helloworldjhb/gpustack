#!/command/with-contenv /bin/bash
# shellcheck shell=bash
# shellcheck disable=SC1091,SC1090
set -o errexit -o nounset -o pipefail

source "${GPUSTACK_ARTIFACT_STORAGE_CONFIG:-/run/gpustack/artifact-storage/.env}"
exec 2>&1
cd "$ARTIFACT_STORAGE_DIR"
# All unauthenticated internal APIs bind to loopback; S3 requires persisted keys.
exec /usr/local/bin/weed server \
    -ip=127.0.0.1 -ip.bind=127.0.0.1 \
    -dir="$ARTIFACT_STORAGE_DIR/data" \
    -master.port=19333 -master.volumeSizeLimitMB=1024 \
    -volume.port=18080 -volume.max=0 \
    -filer -filer.port=18888 \
    -s3 -s3.port="$ARTIFACT_STORAGE_PORT" \
    -s3.port.iceberg=0 -s3.port.lance=0 \
    -s3.config="$ARTIFACT_STORAGE_DIR/s3.json"
